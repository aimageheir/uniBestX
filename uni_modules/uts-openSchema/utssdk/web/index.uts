import type { CanOpenURL, OpenSchema } from '../interface.uts';

export const openSchema: OpenSchema = function (url: string): void {
  try {
    window.open(url, '_blank');
  }
  catch (_e) {
    location.href = url;
  }
};

export const canOpenURL: CanOpenURL = function (url: string): boolean {
  return url != '';
};
