import type { ComponentPublicInstance } from 'vue';

const toastStack = [] as ComponentPublicInstance[];

/**
 * 注册当前页面的 toast 实例到全局栈中
 */
export function registerToast(toastInstance: ComponentPublicInstance) {
  const index = toastStack.indexOf(toastInstance);
  if (index != -1) {
    toastStack.splice(index, 1);
  }
  toastStack.push(toastInstance);
}

/**
 * 全局轻提示与加载等待工具 (Toast & Loading)
 *
 * 统一轻提示体验：底层桥接 AppRoot 统一挂载的高颜值灵动岛 AppToast 组件，
 * 提供成功、失败、警告、加载中等丰富形态，跨端样式 100% 统一。
 */

import {
  hideToast,
  showToast,
  toastError,
  toastInfo,
  toastLoading,
  toastSuccess,
  toastWarning,
  useToast
} from '@/src/components/AppToast/index.uts';
import type { ToastOptions, ToastPosition, ToastType, UseToastReturn } from '@/src/components/AppToast/index.uts';

export {
  hideToast,
  showToast,
  toastError,
  toastInfo,
  toastLoading,
  toastSuccess,
  toastWarning,
  useToast
};
export type { ToastOptions, ToastPosition, ToastType, UseToastReturn };

/**
 * 普通轻提示（无图标，时长 2000ms）
 * @param message 提示文本
 * @param duration 显示时长（默认 2000ms）
 */
export function toast(message: string, duration: number = 2000): void {
  showToast({ title: message, type: 'text', duration });
}

/**
 * 显示全局加载中提示框（默认带透明蒙层防重复操作）
 * @param title 加载中文案，默认为 '加载中...'
 * @param mask 是否显示透明蒙层，默认为 true
 */
export function showLoading(title: string = '加载中...', mask: boolean = true): void {
  toastLoading(title, mask);
}

/**
 * 关闭全局加载中提示框
 */
export function hideLoading(): void {
  hideToast();
  try {
    uni.hideLoading();
  }
  catch {}
}
