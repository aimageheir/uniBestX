import {
  hideToast,
  showToast,
  toastError,
  toastInfo,
  toastLoading,
  toastPromise,
  toastState,
  toastSuccess,
  toastWarning
} from './toastService.uts';
import type { ToastPromiseMessages, ToastState, ToastType } from './types.uts';

export type UseToastReturn = ToastActions;

/** 实例方法让 Android 原生调用可以省略带默认值的参数。 */
class ToastActions {
  /** 当前 Toast 响应式状态 */
  state: ToastState = toastState;

  /** 通用弹出方法（支持纯文本或完整 ToastOptions） */
  show(optionsOrTitle: any, defaultType: ToastType = 'text'): void {
    showToast(optionsOrTitle, defaultType);
  }

  /** 成功提示 */
  success(title: string, duration: number = 2000): void {
    toastSuccess(title, duration);
  }

  /** 错误失败提示 */
  error(title: string, duration: number = 2000): void {
    toastError(title, duration);
  }

  /** 警告提示 */
  warning(title: string, duration: number = 2000): void {
    toastWarning(title, duration);
  }

  /** 信息提示 */
  info(title: string, duration: number = 2000): void {
    toastInfo(title, duration);
  }

  /** 加载等待提示 */
  loading(title: string = '加载中...', mask: boolean = true): void {
    toastLoading(title, mask);
  }

  /** 承接 Promise 异步操作，在原地平滑切换为 success/error 状态（Ding 原地突变） */
  promise<T>(promise: Promise<T>, messages: ToastPromiseMessages): Promise<T> {
    return toastPromise<T>(promise, messages);
  }

  /** 关闭隐藏提示（传 true 时立即销毁，不走离场动画） */
  hide(immediate: boolean = false): void {
    hideToast(immediate);
  }
}

/**
 * AppToast 组合式 Hook
 *
 * 供页面或组件在 setup 中随时调用：
 * ```uts
 * const toast = useToast();
 * toast.success('保存成功');
 * ```
 */
export function useToast(): UseToastReturn {
  return new ToastActions();
}
